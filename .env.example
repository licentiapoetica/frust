POSTGRES_USER=f0ckm
POSTGRES_DB=f0ckm
POSTGRES_PASSWORD=f0ckm
# --- Postgres memory (Optional) ---
# Defaults fit a small server. With ~2 GB of RAM for Postgres: 512MB and 1536MB.
# random_page_cost 1.1 is for SSDs; set 4 on spinning disks.
# PG_SHARED_BUFFERS=256MB
# PG_EFFECTIVE_CACHE_SIZE=1GB
# PG_WORK_MEM=8MB
# PG_MAINTENANCE_WORK_MEM=64MB
# PG_RANDOM_PAGE_COST=1.1
# Secret for hashing user IPs (HMAC-SHA256). Generate once: openssl rand -hex 32
# Kept here instead of config.yaml so a leaked config or DB dump can't be used to reverse IP hashes.
IP_HASH_SECRET=
# --- Nginx Profile (Optional) ---
# Set to 'f0ckm-nginx' for Nginx with Let's Encrypt (Tor always runs)
# COMPOSE_PROFILES=f0ckm-nginx
#
# VIRTUAL_HOST=yourdomain.com
# LETSENCRYPT_HOST=yourdomain.com
# LETSENCRYPT_EMAIL=your-email@example.com
#
# --- Bot protection (Optional) ---
# Anubis in front of f0ckm (docker-compose.anubis.yml): browsers solve a proof of work once per IP.
# Needs JavaScript; the .onion keeps working without. With your own proxy, forward to 127.0.0.1:8923.
# The installer's answer (1/0); without it ./install.sh asks
# ANUBIS=0
# COMPOSE_FILE=docker-compose.yml:docker-compose.anubis.yml
# ANUBIS_KEY=   (openssl rand -hex 32)
# Domains Anubis may send visitors back to after the check, comma-separated (default: VIRTUAL_HOST)
# ANUBIS_DOMAINS=yourdomain.com,www.yourdomain.com
#
# User and group the app runs as and that owns f0ckm-data (default 1000:1000; install.sh sets the checkout's owner)
# UID=1000
# GID=1000
